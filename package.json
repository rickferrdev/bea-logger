{
	"name": "@rickferrdevelop/bea-logger",
	"description": "A small, flexible and transport-agnostic logger for TypeScript.",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=18"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build:js": "bun build ./index.ts --outdir ./dist --target node --format esm",
		"build:types": "bunx tsc --project tsconfig.build.json",
		"build": "bun run clean && bun run build:js && bun run build:types",
		"typecheck": "bunx tsc --noEmit",
		"check:publish": "bun run typecheck && npm pack --dry-run",
		"publish:next": "npm publish --tag next --access public --registry https://registry.npmjs.org/",
		"prepublishOnly": "bun run typecheck",
		"prepack": "bun run build"
	},
	"publishConfig": {
		"access": "public",
		"tag": "next",
		"registry": "https://registry.npmjs.org/"
	},
	"license": "MIT",
	"author": {
		"name": "rickferrdev",
		"url": "https://github.com/rickferrdev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rickferrdev/bea-logger.git"
	},
	"bugs": {
		"url": "https://github.com/rickferrdev/bea-logger/issues"
	},
	"homepage": "https://github.com/rickferrdev/bea-logger#readme",
	"keywords": [
		"logger",
		"logging",
		"typescript",
		"bun",
		"transport"
	],
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	}
}
